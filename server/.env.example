# Leave unset to use a local SQLite file (server/stemguess.db).
# Local Postgres (docker compose up -d):
# DATABASE_URL=postgresql://stemguess:stemguess@localhost:5432/stemguess
DATABASE_URL=

# Extra origins allowed to connect (the server's own origin is always allowed).
# localhost:5173 = Vite dev server, https://localhost = Capacitor Android,
# capacitor-electron://- = Capacitor Electron.
CORS_ORIGINS=http://localhost:5173,https://localhost,capacitor-electron://-

# Music.ai (only needed by scripts/process_songs.py, never shipped to clients)
MUSIC_AI_API_KEY=
# Slug of a stem-separation workflow created in the Music.ai dashboard
# (e.g. outputs: vocals, drums, bass, guitars, keys, other).
MUSIC_AI_WORKFLOW=

# Stem clip length in seconds, cut from the song's most energetic part
# (requires ffmpeg on PATH; 0 = keep full song).
CLIP_SECONDS=15

# Cloudflare R2 (only needed by scripts/upload_r2.py, never shipped to clients)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public bucket URL, e.g. https://pub-xxxx.r2.dev or a custom domain
R2_PUBLIC_URL=

# Rounds last as long as the song clip, with stems revealed evenly across it.
# These are only used when a clip's length can't be read (non-WAV files without ffprobe).
STEM_REVEAL_SECONDS=8
ROUND_EXTRA_SECONDS=10
